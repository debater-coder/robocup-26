digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
"RoboCup Controller" [label="⚡ RoboCup Controller\nSuccessOnAll", shape=parallelogram, style=filled, fillcolor=gold, fontsize=9, fontcolor=black];
Camera [label=Camera, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"RoboCup Controller" -> Camera;
Movement [label=Movement, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"RoboCup Controller" -> Movement;
"Stop/Go" [label="Stop/Go", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Movement -> "Stop/Go";
"Avoid Out of Bounds" [label="Avoid Out of Bounds", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Movement -> "Avoid Out of Bounds";
"Attempt Goal" [label="Attempt Goal", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Movement -> "Attempt Goal";
"Has Posession?" [label="Has Posession?", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Attempt Goal" -> "Has Posession?";
"Goal Selector" [label="Goal Selector", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
"Attempt Goal" -> "Goal Selector";
"Score Goal" [label="Score Goal", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
"Goal Selector" -> "Score Goal";
"Goal Close?" [label="Goal Close?", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Score Goal" -> "Goal Close?";
"Kick Ball" [label="Kick Ball", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Score Goal" -> "Kick Ball";
"Go to Goal" [label="Go to Goal", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
"Goal Selector" -> "Go to Goal";
"Get Goal Target" [label="Get Goal Target", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Go to Goal" -> "Get Goal Target";
"Goal Chase" [label="Goal Chase", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"Go to Goal" -> "Goal Chase";
"Ball Chase" [label="Ball Chase", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Movement -> "Ball Chase";
"/goal/target" -> "Goal Chase" [color=green, constraint=false, weight=0];
"Get Goal Target" -> "/goal/target" [color=blue, constraint=false, weight=0];
"/goal/bb" -> "Kick Ball" [color=green, constraint=false, weight=0];
"/goal/bb" -> "Get Goal Target" [color=green, constraint=false, weight=0];
"/goal/bb" -> "Goal Close?" [color=green, constraint=false, weight=0];
Camera -> "/goal/bb" [color=blue, constraint=false, weight=0];
"/ball/centre" -> "Ball Chase" [color=green, constraint=false, weight=0];
Camera -> "/ball/centre" [color=blue, constraint=false, weight=0];
Camera -> "/ball/radius" [color=blue, constraint=false, weight=0];
subgraph Blackboard {
id=Blackboard;
label=Blackboard;
rank=sink;
"/goal/target" [label="/goal/target: -", shape=box, style=filled, color=blue, fillcolor=white, fontsize=8, fontcolor=blue, width=0, height=0, fixedsize=false];
"/goal/bb" [label="/goal/bb: -", shape=box, style=filled, color=blue, fillcolor=white, fontsize=8, fontcolor=blue, width=0, height=0, fixedsize=false];
"/ball/centre" [label="/ball/centre: -", shape=box, style=filled, color=blue, fillcolor=white, fontsize=8, fontcolor=blue, width=0, height=0, fixedsize=false];
"/ball/radius" [label="/ball/radius: -", shape=box, style=filled, color=blue, fillcolor=white, fontsize=8, fontcolor=blue, width=0, height=0, fixedsize=false];
}
}
